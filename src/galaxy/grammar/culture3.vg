R"VG(
# culture3.vg (H-04, the second pass): how a people spoke: its sayings, its blessings, curses and oaths, what it praised and what it
# scorned, how it spoke of life, death and the years, its signs of luck, what it called its children and its rulers. Each people keeps
# its own few of every pool (`people=K`), so a people's proverbs come back in its letters and sermons and nobody else's.

# =====================================================================================================================
# the sayings (a whole sentence each, a people's eight)
# =====================================================================================================================

proverb (people=8)
  the {crop} does not hurry, and neither should you
  a full {vessel.one.n} has no voice
  who counts the {herd} at night counts wrong
  even {mountain} was a pebble once
  a cold {season.any} makes a warm house
  the {bird.one} that sings first is eaten first
  borrow a {vessel.one.n} and bring it back full
  the river does not ask the stone's leave
  three guests and the bread is thin
  the roof that does not leak is the one nobody mends
  an old {beast} knows the way home
  {food} today is better than a feast at {festival}
  the one who digs the well drinks last
  ask the {herd}, not the herdsman
  smoke goes where the wind says
  a quiet house hears the {bird}
  there is no shade in a borrowed field
  the late {crop} is still {crop}
  a short rope reaches no water
  the hill is steep for the one who carries
  {skyone} does not rise for the lazy
  you cannot plough with a song
  a thin {beast} has many friends at the market
  the one with salt does not need the cook
  {god} gave us two ears and one mouth, and some of us forget it
  when the {fish} come, mend the net before you sing
  rain on the wedding, bread in the house
  a hungry eye sees bread in the moon
  the cart that squeaks gets the fat
  dig before you are thirsty
  no one trips over a mountain; it is the pebbles
  a {garment.n} lent is a {garment.n} lost
  the far field always has the better {crop}
  pour the water before you buy the {vessel.one.n}
  the tallest {tree.n} is the first the wind finds
  every hearth has its smoke
  you do not learn the road from the cart
  a thief knocks once, a friend twice
  speak to the {beast} as you would to the {herd}
  bad news has long legs
  the guest is a gift for three days
  a dull knife cuts the hand
  the one who sweeps the stair sweeps from the top

# a single word for a sort of person the people scorned or praised (a virtue, a vice, mass nouns)
virtue (mass people=3)
  patience
  courage
  thrift
  honesty
  hospitality
  silence
  obedience
  cleverness
  loyalty
  cheerfulness
  modesty
  generosity
  endurance
  piety
  cunning
vice (mass people=3)
  greed
  pride
  sloth
  gossip
  drunkenness
  envy
  cowardice
  idleness
  meanness
  boasting
  waste
  impatience

# =====================================================================================================================
# blessings, curses, oaths, exclamations
# =====================================================================================================================

blessing (people=3)
  may your {herd} be many and your children more
  may the {crop} stand tall
  {god} keep your door
  long days and short winters to you
  salt in your bread and oil in your lamp
  may your {watersrc.n} never run dry
  may your roof hold and your neighbours be quiet
  may {skyone} find you well
  may the road be short and the welcome long
  warm hands and a full {vessel.one.n}
  may your name be said for a long time
  may the {bird} sing on your roof

curse (people=3)
  may your {crop} rot in the field
  may your roof leak where you sleep
  may {god} forget your name
  go and count the stars
  may your {herd} wander
  may your bread never rise
  may you marry a talker
  may your {watersrc.n} taste of salt
  may your cousins visit
  may you live in interesting years

oath (people=3)
  by {god}
  by the {colour.holy} stone
  by my mother's name
  by the bones of my fathers
  by {mountain}
  on my {herd}
  by the first fire
  by {focusword}
  by the {#number} stones
  on my children's heads
  by {river}
  by the salt I have eaten

# a cry of surprise or of trouble
exclaim (people=3)
  {god} help us
  bones and ashes
  by the old ones
  stars above
  mother of {herd}
  {crop} and thunder
  salt and smoke
  well, well
  heavens
  {god}'s teeth

# =====================================================================================================================
# life, death and the years, as the people put them
# =====================================================================================================================

# what a life is like (a noun phrase: "life is {life.is}")
life.is (people=2)
  a river: it goes where it must
  a road walked once
  a thread, and someone else holds the spindle
  a field: you get back what you put in, mostly
  a fire that has to be fed
  a song with more verses than anyone knows
  a loan from {god}
  a day's walk with a heavy load
  a hunt: long waiting, a little running
  a season that ends before you are ready
  a house with the door left open

# the dead: where they went ("my mother has {death.went}")
death.went (people=2)
  gone under the hill
  gone down the river
  gone to the stars
  gone home
  walked into the wind
  gone to sleep in the stone
  crossed the water
  gone back into the {crop}
  gone to {god}
  gone ahead of us
  gone quiet

# where the dead are (a phrase after "the dead are")
dead.are (people=2)
  under the hill
  among the stars
  in the river
  in {god}'s house
  in the names we keep
  in the {crop}, and we eat them, and that is right
  nowhere, and that is a kind of rest
  waiting at the ford
  in the smoke
  in {holyplace}

# the years going by (a clause: "{time.pass}, and ...")
time.pass (people=2)
  the years ran on like water
  the years piled up like snow
  the years turned like the wheel
  the years went by like geese
  the years burned down like a lamp
  the years fell like leaves
  the years went the way of all years
  the years walked past the door

# =====================================================================================================================
# luck, endearments, insults
# =====================================================================================================================

luck.good (people=3)
  a {bird.one} on the roof
  a child born at first light
  rain on a wedding
  (moons>0) {moon} full at a birth
  a white {beast}
  bread that rises twice
  a spider in the house
  a guest at the door before noon
  finding salt
luck.bad (people=3)
  a {bird.one} at night
  a crack in {vessel.one}
  a dog howling at noon
  spilt salt
  a {beast} on the threshold
  (moons>0) {moon} red
  a broken shoe on the road
  whistling in the house
  a fire that will not light

# what a mother called her child
endear (people=3)
  my little {bird.one}
  my heart
  little {beast}
  my lamp
  my {crop} cake
  little fish
  my bird
  my small one
  my treasure

# what they called a fool
fool.word (people=3)
  you goat
  you lump
  you {beast}
  you empty {vessel.one.n}
  you son of a mule
  you turnip
  you great log
  you puddle

# =====================================================================================================================
# their rulers, as the people spoke of them (the year's government: `gov`)
# =====================================================================================================================

ruler.the (people=2)
  (gov=chiefs) the chief
  (gov=chiefs) the headman
  (gov=chiefs) the elders
  (gov=chiefs) the first hunter
  (gov=chiefs) the old one
  (gov=chiefs) the speaker
  (gov=chiefs) the war-leader
  (gov=monarchy has:$ruler) the {$ruler.title}
  (gov=monarchy) the crown
  (gov=monarchy) the throne
  (gov=monarchy) the court
  (gov=council) the elders
  (gov=council) the council
  (gov=council) the twelve
  (gov=council) the old men of the council
  (gov=theocracy) the priests
  (gov=theocracy) the temple
  (gov=theocracy) the holy ones
  (gov=republic) the consuls
  (gov=republic) the senate
  (gov=republic) the government
  (gov=assembly) the Assembly
  (gov=assembly) the delegates
  (gov=corporate) the companies
  (gov=corporate) the board
  (gov=corporate) the directors
  (gov=machine) the mind
  (gov=machine) the system

# the singular words the grammar's other lists need (one of a plural list, a list's word without its article)
vessel.one.n (people=3)
  pot
  basket
  skin
  gourd
  sack
  bowl
  (age>=medieval) jar
  (age>=medieval) cask
  (age>=medieval) bottle
  (age>=industrial) tin
  (age>=modern) box
  (cold=1) birch box
watersrc.n (people=2)
  (desert=0) river
  (desert=0) spring
  (desert=0) stream
  (desert=1) well
  (desert=1) cistern
  (desert=1) oasis
  (age>=industrial) pump
garment.n (people=3)
  cloak
  shawl
  tunic
  robe
  sash
  hood
  apron
  (cold=1) fur
  (desert=1) veil
  (age>=medieval) coat
tree.n (people=2)
  tree
  (desert=0) pine
  (desert=0) oak
  (desert=1) palm
  (desert=1) thorn
bird.one (people=3)
  crow
  lark
  swift
  crane
  heron
  hawk
  owl
  dove
  raven
  finch
  (coast=1) gull
  (desert=1) vulture
  (desert=0) stork
)VG"
