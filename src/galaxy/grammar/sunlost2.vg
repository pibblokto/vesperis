R"VG(
# sunlost2.vg (D-05): the omens kept while the sun dimmed (`dark` 0-1). Registers: `om.e` the way's omens, the signs and stages;
# `om.h` the recent cold, hunger and harvests; `om.pe` the old age's marks. The year's sky and fields are the record's facts.
@apart

@root om.e.* om.h.* om.pe.*

genre.omens (words=24..200)
  (age=prehistoric) {om.p.wall} {@event omen,sign om.pe 80} {om.p.sky} {om.p.end}
  (age=prehistoric) {om.p.wall} {om.p.sky} {om.p.fields} {om.p.read} {om.p.end}
  (age=prehistoric 0.8) {om.p.wall} {om.p.sky} {@event winter,famine om.pe 15} {om.p.fields}
  (tense=past age=medieval) {om.m.head} {@event omen,stage om.e 120} {@event sign,omen om.e 120} {@event winter,famine,harvest om.h 12} {om.m.now} {om.m.close}
  (tense=past age=medieval) {om.m.head} {om.m.now} {@event omen,sign,stage om.e 120} {om.m.fields} {om.m.close}
  (tense=past age=medieval 0.8) {om.m.head} {@event omen,stage om.e 120} {@event sign,omen om.e 120} {@event sign,omen,stage om.e 120} {om.m.close}
  (tense=past age>=industrial age<=modern) {om.i.head} {om.i.obs} {@event omen,sign,stage om.e 120} {@event winter,famine,harvest om.h 12} {om.i.fields} {om.i.close}
  (tense=past age>=industrial age<=modern) {om.i.head} {@event omen,sign,stage om.e 120} {om.i.obs} {om.i.fields}
  (age=futuristic) {om.f.head} {om.f.obs} {@event omen,sign,stage om.e 500} {om.f.fields} {om.f.close}
  (age=futuristic) {om.f.head} {@event omen,sign,stage om.e 500} {om.f.obs} {om.f.close}
  (age=farfuture) {om.f.head} {om.f.obs} {@event omen,sign,stage om.e 1500} {om.f.fields} {om.f.close}

# the register: an omen, a sign, a stage, each with its year

om.e.when
  (age<=industrial) In the year {#$e.year:digits},
  (age<=industrial) In {#$e.year:digits},
  (age<=medieval) The year {#$e.year:digits}:
  (age<=medieval) Under the year {#$e.year:digits},
  (age<=medieval) Of the year {#$e.year:digits} it is written:
  (age<=industrial) That year, {#$e.year:digits},
  (age>=industrial) {#$e.year:digits}:
  (age>=modern) Entered for {#$e.year:digits}:
  ($e.ago>1 $e.ago<=60) {#$e.ago|year} before this,
  ($e.ago>1 $e.ago<=60) {#$e.ago|year} ago,
om.e.omen
  ($e.omen=wanderer) {om.e.when} {sunway.thing} {om.w.did}{om.w.tail}.
  ($e.omen=intruder) {om.e.when} {om.i.thing} {om.i.did}{om.i.tail}.
  ($e.omen=bent) {om.e.when} {om.b.what}{om.b.tail}.
  ($e.omen=bent) {om.e.when} {star} wavered and doubled, and came back to itself by morning.
  ($e.omen=dance) {om.e.when} {om.d.what}{om.d.tail}.
  ($e.omen=comet) {om.e.when} the hairy star came back, and the watchers [counted it among the signs|wrote it down twice].
  ($e.omen=eclipse has:$e.place) {om.e.when} the sun went dark at noon over {$e.place}, and [some said it came back smaller|the {herd} lay down].
  ($e.omen=aurora has:$e.place) {om.e.when} lights filled the night over {$e.place}, and the {herd} would not go out.
  ($e.omen=falling has:$e.place) {om.e.when} stars fell all night over {$e.place}.
  ($e.omen=newstar) {om.e.when} a new star shone for a season and went out.
  ($e.omen=redmoon has:$e.place) {om.e.when} the moon rose red over {$e.place}.
om.w.did
  stood higher than it ever had
  rose before the sun and was still in the sky at noon
  came nearer again, as it had every year since the watch began
  was brighter than {star} and twice as near
  (moons>0) outshone {moon}
om.w.tail
  , and the year that followed was longer
  , and threw a shadow on the snow
  , and the watchers did not sleep
  , over {mountain}
om.i.thing
  the new star
  the stranger star
  {sunway.thing}
om.i.did
  was brighter than the year before
  stood beside the sun at dawn, a little nearer
  could be seen at noon for the first time
  cast shadows of its own
om.i.tail
  , low over {mountain}
  , and the {herd} would not settle
  , and the old ones covered their eyes
  , and it was bigger at the turn of the year than at its start
om.b.what
  the stars near {star} were seen out of their places
  a ring of the sky was found where the stars bent away from nothing
  the stars of one quarter of the sky stood crooked
om.b.tail
  , as if something stood in front of them
  , and in the middle of them was nothing
  , and the watchers could not say why
om.d.what
  the second sun rose further from the first than any watcher had seen it
  the two suns stood apart at noon, further than the year before
  the sister sun went down so far from ours that the evening had two colours
  the second sun took longer to come round than the tables said
om.d.tail
  , and our year was longer for it
  , and nobody could remember them so far apart
  , and the watchers drew the gap on the wall
om.e.sign
  {om.e.when} {$e.sign}.
  {om.e.when} it was set down that {$e.sign}.
  {om.e.when} the roll has only this: {$e.sign}.
  {om.e.when} word came that {$e.sign}.
  ($e.stage<=1) {om.e.when} {$e.sign}, and [few believed it|it was laughed at|the elders said it was nothing].
  ($e.stage>=1) {om.e.when} {$e.sign}, and [nobody argued any more|the old ones nodded].
om.e.stage
  ($e.stage=0) {om.e.when} the watchers began a second roll, for the signs alone.
  ($e.stage=0) {om.e.when} the first of the signs was seen, though nobody called it one then.
  ($e.stage=0) {om.e.when} [the old ones|the watchers|the priests] first spoke of a change in the sky.
  ($e.stage=1) {om.e.when} the summer came short, and every summer after it was shorter.
  ($e.stage=1) {om.e.when} the cold came into the summer and did not leave it.
  ($e.stage=1) {om.e.when} the year [grew longer|stretched], and the summers [came late|went early].
  ($e.stage=2) {om.e.when} the sun was seen to be going.
  ($e.stage=2) {om.e.when} no watcher could say any more that the sun was the sun of the old days.
  ($e.stage=3) {om.e.when} the last of the warmth went below the ground.
om.e.none
  (age<=industrial) The roll of the signs is empty for those years; the watchers wrote only the weather.
  (age>=modern) No sign was entered for the years before this one.

# the recent hardships: the cold, the hunger, the harvests

om.h.winter
  ($e.value>=25) {om.e.when} the long cold began, and [nobody then knew it would not end|the old ones said it would pass].
  ($e.value>=25) {om.e.when} the winter came early and stayed: the first year of the long cold.
  ($e.value<25) {om.e.when} a winter of {#$e.value|year}, and the {herd} thin after it.
om.h.famine
  (has:$e.place) {om.e.when} the hunger came to {$e.place}{om.h.dead}.
  {om.e.when} the stores were empty before the thaw{om.h.dead}.
om.h.dead
  (2)
  ($e.value>0) , and {#$e.value:about} died of it
om.h.harvest
  ($e.harvest=failed) {om.e.when} the {crop} [froze in the ear|did not ripen, and was cut green for the {herd}].
  ($e.harvest=poor) {om.e.when} the {crop} came in thin and late, under frost.
  ($e.harvest=rich) {om.e.when} the {crop} came in heavy: the last good harvest, the old ones say.

# the medieval roll

om.m.head (formula)
  (medium=stone) Cut on the wall of {holyplace} at {$home}: the signs.
  (medium=tablet) The tablet of the signs, kept at {$home}.
  (medium=scroll|medium=codex) The roll of the omens, as the watchers kept it at {$home}.
  What the watchers of {$home} saw in the sky, set down in order.
  (has:$ruler) The signs in the years of {$ruler:full}, for the record.
om.m.now
  {om.n.lead} {om.n.sky}{om.n.tail}.
  (dark=0) {om.n.lead} the sun is as it was; it is the sky round it that has changed.
om.n.lead
  This year
  Now
  In this year's watch,
om.n.sky
  (dark=0 sunway=wanderer) {sunway.thing} is brighter than {star}
  (dark=0 sunway=intruder) the new star rises with the sun and sets after it
  (dark=0 sunway=dark) the stars round the empty place have moved again
  (dark=0 sunway=dance) the two suns are never seen together at noon
  (dark=1) {sun} rises late and low
  (dark=1) the summer is a few days of warmth between frosts
  (dark=1) the sun fills less of the watchers' ring than it did
  (dark=1) the {herd} stand together in the fields at noon as if evening had come
om.n.tail
  , and the old ones will not look up
  , and the watchers have stopped arguing
  , and the priests have ordered fires
  , and nobody speaks of it at {festival}
om.m.fields
  {om.mf.what}{om.mf.tail}.
om.mf.what
  (harvest<=1) The {crop} froze in [the fields|the ear|the furrows] this year
  (harvest<=1 lastharvest<=1) The {crop} has failed two years now
  (harvest=2) The {crop} came in [thin|late|light], between the frosts
  (harvest=2) Half the {crop} was cut green, ahead of the frost
  (harvest>=3) The {crop} came in well this year
  (harvest>=3) A good year for the {crop}, against all the signs
om.mf.tail
  (harvest<=1) , and the {herd} were brought in early
  (harvest<=1) , and the seed is being eaten
  (harvest=2) , and the granary of {$home} is half empty
  (harvest>=3) , and nobody said aloud that it might be the last
  (harvest>=3) ; the granaries of {$home} are full
  , and the watchers wrote it down beside the signs
om.m.close (formula)
  So far the signs.
  The watchers have asked for more oil for the lamps, since the nights are longer.
  {god.keep}.
  (faith!=philosophy faith!=machine) {god} turn the sky back.
  Here the hand changes.

# the industrial and modern record: the observatory and the farms

om.i.head (formula)
  The observatory at {$home}: the year's notes, with the farms' returns.
  Notes of the sky and the harvest, kept at {$home}.
  (age=modern) Observations, {$home}, the year {#year:digits}. For the record.
  (age=industrial) Kept at {$home} by the society of the watchers, for any who come after.
om.i.obs
  {om.o.what}; {om.o.tail}.
om.o.what
  (sunway=wanderer) {sunway.thing} measured again, brighter by [a tenth|a fifth|half] than last year
  (sunway=wanderer) the calculation of {sunway.thing}'s road was made [three times|again] and agreed
  (sunway=wanderer) {sunway.thing} shows a disc in the small glass now
  (sunway=wanderer) {sunway.thing} passed nearer the sun's road than the tables allow
  (sunway=intruder) the new star's light was measured at the turn of the year, [doubled|half again] since the watch began
  (sunway=intruder) the new star is near enough now that its colour shows
  (sunway=intruder) the new star's place among the old stars was taken again, and it moves
  (sunway=dark) the stars round the empty place were measured again
  (sunway=dark) the plates show the stars bending round a point where nothing is
  (sunway=dark) the empty place has crossed [{star}|two figures of the sky] since the watch began
  (sunway=dance) the second sun was measured at its furthest
  (sunway=dance) the two suns' dance was timed again, [longer|slower] than ever
  (sunway=dance) the gap between the suns at sunset was the widest yet
  (dark=1) the sun's disc is smaller than the tables give it
  (dark=1) the noon heat at {$home} was the lowest ever taken
  (dark=1) the sun's light at noon was [a third|half] what the old tables give
om.o.tail
  the figure is worse than last year's
  the instruments were checked and were right
  there is no error in it
  the old tables will have to be thrown away
  nobody at the observatory slept that night
  the society has asked for it to be kept quiet
  the papers will have it by morning
om.i.fields
  {om.if.what}{om.if.tail}.
om.if.what
  (harvest<=1) The farms' returns: the {crop} down by [half|two thirds|a third]
  (harvest<=1) The {crop} failed again across [the plain|the valley of {river}|the high farms]
  (harvest<=1) The frost took the {crop} in [the ear|the field|the first week of summer]
  (harvest=2) The returns are thin but not ruinous
  (harvest=2) The {crop} was cut early, ahead of the frost
  (harvest=2) The {crop} came in late and light
  (harvest>=3) The {crop} came in full this year
  (harvest>=3) A full harvest, against every sign
om.if.tail
  (harvest<=1) ; the stores of {$seat} are being opened
  (harvest<=1) , and the {herd} were brought under cover in summer
  (harvest=2) ; the farmers are holding back their seed
  (harvest=2) , and the price of {food} rose at {$seat}
  (harvest>=3) ; the farmers sold nothing and stored everything
  (harvest>=3) , and nobody at the observatory believed it would last
om.i.close (formula)
  The watch continues.
  End of the year's notes.
  (age=modern) These figures are passed to {ruler.the}.

# the old age's marks, read by the ship

om.p.wall (formula)
  (medium=painted) {pre.wall.where}, in {pre.paint}, the sky.
  (medium=painted) On the wall of the shelter, in {colour.holy}, a sky painted over the old hunts.
  (medium=stone) Pecked into a flat stone by {river}: the sky, night after night.
  (medium=stone) Cut into {pre.stone.where}, the lines filled with {colour.holy}: the sky.
  (medium=bone) Cut along a {pre.bone}, very small: the sky, turn by turn.
om.p.sky
  (sunway=wanderer) {om.ps.sun}, and beside it a smaller light that grows from mark to mark: the ship reads it as the wanderer.
  (sunway=intruder) A star with long rays over the hills, drawn larger at each turn of the moon until it is as large as the sun.
  (sunway=intruder) {om.ps.sun}, and next to it a star with rays, and figures pointing at the star.
  (sunway=dark) The stars drawn in their figures, but in one place they bend away round a ring left bare.
  (sunway=dark) {om.ps.sun}, and above it a black ring with the stars drawn crooked round it.
  (sunway=dance) Two suns, one large and one small, drawn holding hands; in the last figure their hands are apart.
  (sunway=dance) {om.ps.sun}, and a second sun drawn further from it in every figure.
om.ps.sun
  Round marks in a row for the sun
  The sun drawn over and over along the wall
  The sun at every turn of the moon
om.p.fields
  (dark=1) The sun in the last figures is drawn small, and under it the figures are wrapped in skins.
  (dark=1) Under the small sun, the {herd} drawn lying down in the snow.
  (harvest<=1) Empty bowls drawn in a row under the new light.
  The {herd} drawn thin, and {pre.stroke} for the days they stayed in.
  Fires drawn on the hills, and figures standing by them, looking up.
om.p.read
  (moons>0) The ship reads it as a count of nights: the watchers drew what they saw each time {moon} was full.
  The ship takes it for a warning: the marks are cut hard, many times over.
  The ship reads it as a watch kept for years by one hand, the strokes the same strokes to the end.
om.p.end
  (medium=painted) {wall.state}
  (medium=stone) {stone.state}
  (medium=bone) The bone is worn smooth where it was held.
  (medium=bone) The last marks are shallow, cut in a hurry, or by cold hands.
om.pe.when
  At one turn,
  Near the end,
  Among the marks,
om.pe.omen
  ($e.omen=wanderer) {om.pe.when} the wanderer drawn with a ring round it, and figures pointing.
  ($e.omen=intruder) {om.pe.when} the new star drawn with its rays crossing the sun's.
  ($e.omen=bent) {om.pe.when} the stars drawn crooked round an empty ring.
  ($e.omen=dance) {om.pe.when} the two suns drawn back to back.
  ($e.omen=comet) {om.pe.when} a star with a tail: the hairy star.
  ($e.omen=eclipse) {om.pe.when} the sun drawn black, with a ring of {colour.holy} round it.
  ($e.omen=aurora) {om.pe.when} wavy lines over the whole sky: the lights.
  ($e.omen=falling) {om.pe.when} short strokes falling from the top: the night the stars fell.
  ($e.omen=newstar) {om.pe.when} one star drawn larger than the rest.
  ($e.omen=redmoon) {om.pe.when} the moon drawn in {colour.holy}.
om.pe.sign
  {om.pe.when} a sign the ship reads as this: {$e.sign}.
om.pe.winter
  {om.pe.when} a white hand over a whole turn: the long cold.
  {om.pe.when} the {herd} drawn in the snow, and the snow drawn over everything after.
om.pe.famine
  {om.pe.when} empty bowls in a row: the hunger.
om.pe.none
  The marks between the figures count nothing the ship can read.
)VG"
