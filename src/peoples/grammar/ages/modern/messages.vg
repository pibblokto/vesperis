R"VG(
# messages.vg (H-04, the second pass): the messages (a drive, the modern and the futuristic ages): two of a family, short and often, the
# writer first (`@cast letter`): the errands, the house, the children, the weather, the news (`@news ... letter`), the worry when the
# collapse comes. Their food, their drink, their streets, their crafts and their sports are in them, so a people's messages are its own.

genre.messages (words=13..75)
  {@cast letter}{msg.line}\n{msg.reply}\n{msg.line}\n{msg.reply}\n{msg.last}
  {@cast letter}{msg.open}\n{msg.ask}\n{$me:name}: {@news any letter}\n{msg.react}
  {@cast letter}{msg.errand}\n{msg.ok}\n{msg.line}\n{msg.reply}
  {@cast letter}{msg.home}\n{msg.reply}\n{msg.home}\n{msg.last}
  {@cast letter}{msg.open}\n{msg.ask}\n{$me:name}: {@news private letter}\n{msg.react}\n{msg.last}
  {@cast letter}{msg.line}\n{msg.reply}\n{msg.home}\n{msg.ok}\n{msg.errand}\n{msg.reply}
  (2 stage>=1) {@cast letter}{msg.worry}\n{msg.calm}\n{msg.worry}\n{msg.reply}
  (stage>=1) {@cast letter}{msg.worry}\n{msg.calm}\n{msg.line}\n{msg.last}

# ---- the writer's lines -----------------------------------------------------------------------------------------------------

msg.line
  (once) {$me:name}: are you home?
  (once) {$me:name}: did you see the news?
  (once) {$me:name}: call me when you get this
  (once) {$me:name}: I'm at {$me.home}, the line's bad
  (once) {$me:name}: happy {festival}! save me some {food}
  (once) {$me:name}: we're out of {drink} again
  (once) {$me:name}: the {msg.thing} is broken again
  (once) {$me:name}: we've got {weather.now} here. you?
  (once) {$me:name}: are you watching {pastime} tonight?
  (once) {$me:name}: I found that {garment.n} you lost
  (once) {$me:name}: bring the {vessel.one.n} back when you come
  (once) {$me:name}: don't forget the {craft} class tomorrow
  (once) {$me:name}: {exclaim}. the {msg.transit} is late again, don't wait up
  (once has:$me.home.landmark) {$me:name}: you'll never guess who I saw at {$me.home.landmark}
  (once has:$child) {$me:name}: tell {$child:name} the {msg.gift} is in the post
  (once has:$spouse) {$me:name}: {$spouse:name} says hello and wants the {mod.tool.n} back
  (once economy=herding|economy2=herding) {$me:name}: the {herd} got out again. don't ask
  (once) {$me:name}: the {colour.any} {garment.n} or the {colour.any} one?
  (once) {$me:name}: what time is {feast.custom}?
  (once) {$me:name}: who has the keys to the {msg.place}?
  (once) {$me:name}: is it true about the {msg.rumour}?
  (once age>=futuristic) {$me:name}: the transit's down again. walking
  (once age>=futuristic) {$me:name}: did the garden level get the {fruit} in?
  (once age>=futuristic) {$me:name}: your feed has been quiet for days. all well?
  (once age>=futuristic) {$me:name}: the garden level has {fruit} again. come and see
  (once age>=futuristic has:mind) {$me:name}: did the mind answer your request?
  (once age>=futuristic) {$me:name}: the recyclers are on the blink again
  (once age>=futuristic) {$me:name}: on the pod, ten minutes
  (once age>=futuristic) {$me:name}: they're opening the old {msg.place} on the lower level
  (once age>=futuristic) {$me:name}: your feed says you're asleep. you're not, are you
  (once age>=futuristic) {$me:name}: the light in the east district failed again
  (once age>=futuristic) {$me:name}: the stack's quiet tonight. half of them have gone to {$seat}

msg.thing (people=4)
  boiler
  radio
  lift
  roof
  car
  stove
  heater
  pump
  door lock
  washing machine
  (age>=futuristic) recycler
  (age>=futuristic) door

msg.transit (people=2)
  tram
  bus
  ferry
  night train
  (age>=futuristic) pod

msg.place (people=3)
  shed
  allotment
  shop
  workshop
  cellar
  boat
  garage

msg.gift (people=3)
  parcel
  {craft} kit
  book
  {mod.instrument.n}
  {garment.n}

msg.rumour (people=3)
  {watersrc.n}
  {craft} works
  new road
  school
  hospital
  prices

mod.tool.n (people=2)
  hammer
  saw
  drill
  ladder
  spade
  shears

mod.instrument.n (people=2)
  drum
  flute
  fiddle
  horn
  pipes

# ---- the reader's replies ---------------------------------------------------------------------------------------------------

msg.reply
  (once) {$you:name}: yes
  (once) {$you:name}: not yet, at work
  (once) {$you:name}: ok
  (once) {$you:name}: what news
  (once) {$you:name}: I'll call later
  (once) {$you:name}: love you
  (once) {$you:name}: on my way
  (once) {$you:name}: can't, working late
  (once) {$you:name}: which {food}?
  (once) {$you:name}: they're out of it at the {msg.shop}
  (once) {$you:name}: {endear}, of course
  (once) {$you:name}: you said that last time
  (once) {$you:name}: tell me later
  (once) {$you:name}: {exclaim}
  (once) {$you:name}: don't start
  (once) {$you:name}: is that all?
  (once) {$you:name}: I'll ask at the {msg.shop}
  (once) {$you:name}: under the stairs, where it always is
  (once inv.photography=1) {$you:name}: send a picture
  (once stage>=1) {$you:name}: we're fine. stay where you are
  (once stage>=2) {$you:name}: I can't. not yet
  (once age>=futuristic) {$you:name}: the pod's late too
  (once age>=futuristic) {$you:name}: I muted the feed. it's better
  (once age>=futuristic has:mind) {$you:name}: ask the mind, it knows everything

msg.shop (people=3)
  market
  corner shop
  co-op
  baker's
  stall by the station
  {craft} shop

msg.ok
  {$you:name}: ok
  {$you:name}: will do
  {$you:name}: fine
  {$you:name}: yes, yes
  {$you:name}: got it

# ---- the errands, the house -----------------------------------------------------------------------------------------------

msg.errand
  {$me:name}: if you pass the {msg.shop}, get {food} and {drink}
  {$me:name}: we need {food}, and something for the {msg.thing}
  {$me:name}: can you pick up the {fruit} for {feast.custom}?
  {$me:name}: get the good {food}, not the cheap one
  {$me:name}: the {craft} shop has your order. pick it up before they close
  {$me:name}: buy {fuel} if you see any. we're nearly out
  {$me:name}: the {vessel.one.n} for the {veg}, the big one, not the cracked one
  {$me:name}: two loaves and whatever {fruit} looks good

msg.home
  (has:$child) {$me:name}: {$child:name} can {skill} now and won't stop showing us
  {$me:name}: the roof's leaking again over the {msg.room}
  {$me:name}: we painted the door {colour.any}. the neighbours have opinions
  {$me:name}: the neighbours have a new {beast}. it never stops
  {$me:name}: the {craft} works is hiring again
  {$me:name}: it's {feast.custom} on the rest day. come if you can
  {$me:name}: the {msg.thing} works again. don't ask what it cost
  {$me:name}: {weather.now} all week. the {veg} have given up
  (has:$spouse) {$me:name}: {$spouse:name} has taken up the {mod.instrument.n}. pray for us
  {$me:name}: the street's been dug up again outside the {msg.place}
  (has:$me.home.quarter) {$me:name}: they're knocking down half of {$me.home.quarter}
  {$me:name}: we had {food} for the third night running. it was fine
  {$me:name}: found the old {craft} things of grandmother's in the cellar
msg.room (people=2)
  kitchen
  stairs
  back room
  bath
  children's room

# ---- the news ----------------------------------------------------------------------------------------------------------------

msg.open
  {$me:name}: are you there?
  {$me:name}: have you heard?
  {$me:name}: news from here
  {$me:name}: call me when you can
  {$me:name}: sit down first
  {$me:name}: you'll want to hear this
msg.ask
  {$you:name}: what news
  {$you:name}: here now. what is it
  {$you:name}: tell me
  {$you:name}: what now
  {$you:name}: good or bad?
msg.react
  {$you:name}: I'll call tonight
  {$you:name}: thank you for telling me
  {$you:name}: I'll tell the others
  {$you:name}: love you
  {$you:name}: {exclaim}
  {$you:name}: I don't know what to say
  {$you:name}: we'll talk at {feast.custom}
msg.last
  {$me:name}: ok. love to everyone
  {$me:name}: talk tomorrow
  {$me:name}: kiss the children
  {$me:name}: {blessing}
  {$me:name}: going now, the {msg.transit}'s here
  (stage>=2) {$me:name}: then I'll come to you

# ---- the collapse's ---------------------------------------------------------------------------------------------------------

msg.worry
  {$me:name}: are you all right? the news is bad
  {$me:name}: have you got enough {food}?
  {$me:name}: the {watersrc.n} is off again here
  {$me:name}: they've closed the {msg.shop}
  {$me:name}: is the {msg.transit} still running your way?
  (stage>=2) {$me:name}: we're leaving tomorrow. come with us
  (stage>=2) {$me:name}: the {msg.place} is empty. everyone's gone
  {$me:name}: keep {fuel} by the door, just in case
msg.calm
  {$you:name}: we're fine. stay where you are
  {$you:name}: don't worry about us
  {$you:name}: we have enough. for now
  {$you:name}: it's quieter here than they say
  {$you:name}: stop reading the news
)VG"
