R"VG(
# propaganda_emergency.vg (H-04; the second pass): the rule's own voice and the collapse's on the air: propaganda (a poster, a leaflet: a people's
# slogans are its own, made of its crops, its crafts, its virtues and its sacred colour) and the emergency broadcast (the collapse's
# years: what happened, by the cause, and what to do, with that people's water, fuel, food and vessels).

# ---- propaganda ---------------------------------------------------------------------------------------------------------------

genre.propaganda (words=10..50)
  {prop.line} {prop.line} {prop.end}
  {prop.line} {prop.line} {prop.line} {prop.end}
  {prop.head} {prop.line} {prop.line} {prop.end}

prop.head (people=2)
  Citizens!
  People of {city}!
  Workers of {$home}!
  Mothers and fathers!
  Neighbours!

prop.line
  (2) {prop.slogan}
  (2) {prop.do}
  (war=1) {prop.war}
  (stage>=0) {prop.late}
  (contact=1) {prop.others}

prop.slogan (share=0.6)
  {city} works. {city} builds. {city} endures.
  Together we are the {people}.
  Trust {ruler.the}.
  Every citizen has a part to play.
  {virtue} is strength. {vice} is the enemy's friend.
  The {craft} works are the heart of {city}.
  Under {focusword}, we are one.
  The {colour.holy} banner flies over every school.
  Your work is seen by {ruler.the}, and remembered.
  A nation that grows its own {crop} answers to no one.
  The {people} keep their word.
  We built {$seat} with our hands, and we will keep it with them.
  As the {river} runs, so does the work.
  Strong {herd}, strong children, strong {city}.
  A full {vessel.one.n} on every table: that is our promise.
  Remember the founder. Be worthy of {founder}.
prop.do (share=0.6)
  Report waste. Report rumour. Report anything.
  Grow more {crop}. Waste no {food}.
  Save {fuel}: the cold is the enemy's ally.
  Do not waste the {watersrc.n}. Water is the nation.
  Learn the {festival} songs. Teach them to your children.
  Learn a craft. {craft} feeds the nation.
  Be on time. Your {msg.transit} is.
  Keep your street clean. Keep your thoughts cleaner.
  Speak well of your neighbour, and listen to what your neighbour says.
  Give one day a month to the {craft} works.
  Plant a {tree.n} for every child.
  Do your duty at {holyplace}, and at the works.
prop.war
  Our soldiers are winning. Give what you can.
  The enemy is listening. Say nothing.
  Every mouthful of {food} you save feeds a soldier.
  The front needs {material}. Bring yours to the hall.
  Our {herd} feed the army. Do not hoard.
prop.late
  There is no shortage. There is only waste.
  (stage>=1) Stay where you are. Leaving is betrayal.
  (stage>=1) The crisis is over. Return to work.
  (stage>=1) Rumour kills more than {mod.cause.noun} does.
  (stage>=2) The halls are open. The rations are fair. The rumours are lies.
prop.others
  The {other} are our friends. Trade with them.
  Do not listen to the {other}.
  The {other} want our {crop}. They will not have it.
mod.cause.noun
  (cause=famine|cause=cropfailure|cause=foodsystems) hunger
  (cause=sickness|cause=greatsickness|cause=epidemics|cause=engineered) the sickness
  (cause=flood|cause=climate) the water
  (cause=bandwar|cause=civilwar|cause=conquest|cause=industrialwar|cause=waterwar|cause=nuclear|cause=weapons) the war
  (cause=drying) the drought
  (cause=coalout|cause=cascade) the cold
  (cause=sunlost 3) the dark
  (cause=sunlost 3) the cold
  fear

prop.end (formula people=3)
  Issued by {ruler.the}.
  Display in all public places.
  Printed at {$seat} by order.
  Do not remove this notice.
  By authority.
  Pass it on.

# ---- the emergency broadcast ----------------------------------------------------------------------------------------------

genre.emergency (words=24..80)
  {em.open} {em.what} {em.do} {em.do} {em.close}
  {em.open} {em.what} {em.where} {em.do} {em.close}
  {em.open} {em.what} {em.do} {em.do} {em.do} {em.close}

em.open (formula people=3)
  This is an emergency broadcast.
  This is an emergency broadcast from {$seat}. Please listen carefully.
  This is {$seat}. An emergency announcement follows.
  Attention. This is a message from {ruler.the}.
  Stop what you are doing and listen. This is an emergency broadcast.

em.what
  (3) {em.cause} {em.add}
  The situation in the {em.where2} is serious.
  (cause!=fewerchildren cause!=chosen cause!=leaving cause!=exodus cause!=retreat cause!=elsewhere) There has been a failure of the {em.sys} in {$home}.
  The {em.sys} cannot be relied on for the next {#n|day}.
em.cause
  (cause=famine|cause=cropfailure|cause=foodsystems) There is not enough food, and {em.fam2}.
  (cause=iceage|cause=cold|cause=volcanic) The cold has reached {$home}; {em.cold2}.
  (cause=flood|cause=climate) The water is still rising; {em.flood2}.
  (cause=sickness|cause=greatsickness|cause=epidemics|cause=engineered) The sickness has reached {em.sick2}; the hospitals are {em.full}.
  (cause=bandwar|cause=civilwar|cause=conquest|cause=industrialwar|cause=waterwar) The fighting has reached {em.war2}.
  (cause=nuclear|cause=weapons) There have been explosions in the {em.dir}. The wind is from the {em.dir}.
  (cause=drying) The reservoirs are empty. The {watersrc.n} is the last water {em.dry2}.
  (cause=impact) The impact has darkened the sky; it will stay dark {em.dark2}.
  (cause=poisoned) The water and the air in {em.pois2} are not safe.
  (cause=coalout|cause=cascade) The grid has failed and will not be restored {em.grid2}.
  (cause=revolution) The government has left {$seat}. Order is kept by {em.order2}.
  (cause=fewerchildren|cause=chosen) There are fewer of us every year, and {em.few2}.
  (cause=leaving|cause=exodus|cause=elsewhere|cause=retreat) The last convoys leave {$seat} {em.leave2}.
  (cause=machine|cause=nanotech|cause=geoengineering|cause=flare|cause=physics|cause=undescribed) Something has happened {em.odd2}.
  (cause=sunlost) The sun has set for the last time over {$seat}; {em.sun2}.
em.add (people=3)
  (3)
  It is getting worse.
  The reports say so from every district.
  This is not a rumour.
  We will not pretend otherwise.
  The {craft} guild has confirmed it.
em.fam2 (people=2)
  the next harvest will not be enough either
  the stores are nearly empty
  the {crop} has failed in every district
  the price of {food} has trebled in a week
em.cold2 (people=2)
  the roads north are closed by snow
  the river is frozen to its bed
  the pipes have burst in every street
em.flood2 (people=2)
  the low districts of {$home} are under it
  the bridges are closed
  the dykes at {$home} will not hold another night
em.sick2 (people=2)
  every town
  {$home}
  the schools and the barracks
em.full (people=2)
  full
  closed to new cases
  in the halls now
em.war2 (people=2)
  the outskirts of {$home}
  the river crossings
  the roads into {$seat}
em.dir
  north
  east
  south
  west
em.dry2 (people=2)
  there is
  in the district
  we have
em.dark2 (people=2)
  for some time
  through {season.next}
  longer than anyone will say
em.pois2 (people=2)
  the river towns
  {$home}
  the lower districts
em.grid2 (people=2)
  tonight
  this week
  in {season.now}
em.order2 (people=2)
  the street committees
  the {craft} guild
  the neighbours
em.few2 (people=2)
  the outer towns are closing
  the schools are empty
  the halls are full of the old
em.leave2 (people=2)
  within the week
  tomorrow at first light
  when the roads clear
em.odd2 (people=2)
  that we do not understand
  that the instruments cannot measure
  and nobody can say what
em.where
  The worst is in the {em.where2}; the rest of the land is quiet, for now.
  The roads to {$seat} are open; the roads north are not.
  Help is coming from {$seat}, but it is slow.
em.where2 (people=3)
  northern districts
  coastal towns
  capital
  outer towns
  river valleys
  hill country
em.sys (people=3)
  water supply
  grid
  food distribution
  communications
  trams
  hospitals

em.do
  (once) Do not use {em.roads} unless told to.
  (once) Listen for further instructions on {em.freq}.
  (once stage>=2) Make your way to {$seat} {em.how} if you can.
  (once) Bring your own {vessel} to {em.hall}; water will be given out {em.when}.
  (once) Take {food} for {#n|day}, {em.take2}, and nothing else.
  (once) Keep {fuel} {em.keep}. Share it with your neighbours.
  (once) Do not drink water from the {watersrc.n} until it has been {em.boiled}.
  (once) Check on the old and the sick in your {em.street}.
  (once) Keep the {herd} {em.herdwhere}.
  (once) Keep the children at home. The schools are closed {em.until}.
  (3 once cause=sickness|cause=greatsickness|cause=epidemics|cause=engineered) Stay {em.in}. Do not visit the sick; the sick will be visited.
  (3 once cause=sickness|cause=greatsickness|cause=epidemics|cause=engineered|cause=poisoned) Boil all water{em.boil2}.
  (3 once cause=flood|cause=climate) Go to high ground {em.hg}. Take water, medicine and warm clothing.
  (3 once cause=famine|cause=cropfailure|cause=foodsystems) Ration cards are valid at every {em.hall2}. Bring them.
  (3 once cause=nuclear|cause=weapons|cause=industrialwar|cause=waterwar|cause=civilwar|cause=conquest) Stay {em.in}, away from {em.away}.
  (3 once cause=cascade|cause=coalout) Keep warm. Gather in {em.hall}, where there is heat.
  (3 once cause=fewerchildren|cause=chosen) The outer districts are closing. Move to the centre of {$seat}; there are homes for {em.everyone}.
  (3 once cause=iceage|cause=cold|cause=volcanic|cause=impact|cause=flare) Stay inside. Keep the fires going {em.fires}. Share them.
  (3 once cause=drying) Water is rationed at {em.hall}. Bring your own {vessel}.
  (once) Assemble at the nearest {em.hall2} if your home is not safe.
em.roads (people=2)
  the roads
  the bridges
  the coast road
  the trams
em.freq (people=2)
  this frequency
  this station
  the street speakers
em.how (people=2)
  on foot
  by the river road
  with your neighbours
em.hall (people=2)
  the halls
  the schools
  the market hall
  the station
em.hall2 (people=2)
  school or hall
  station
  market hall
em.when (people=2)
  at noon
  at first light
  twice a day
em.take2 (people=2)
  warm clothing
  a blanket
  your papers
  a lamp
em.keep (people=2)
  for the nights
  by the door
  dry
em.boiled (people=2)
  boiled
  boiled twice
  strained and boiled
em.street (people=2)
  street
  building
  yard
em.herdwhere (people=2)
  indoors
  in the pens
  away from the river
em.until (people=2)
  until further notice
  for the week
  until {season.next}
em.in (people=2)
  indoors
  in the cellars
  inside
em.away (people=2)
  the windows
  the doors
  the river side
em.boil2
  (2)
  , even from the pump
  , and the milk
em.hg (people=2)
  now
  by the north road
  before dark
em.everyone (people=2)
  everyone
  all who come
  every family
em.fires (people=2)
  day and night
  in one room only
  low

em.close (formula people=3)
  This message will be repeated.
  This message will be repeated every hour.
  Stay tuned to this frequency.
  Keep calm. Help each other.
  {god.call}.
)VG"
