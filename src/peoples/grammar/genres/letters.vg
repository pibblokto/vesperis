R"VG(
# letters.vg (H-04; the second pass 2026-10-10): the letter: a person of the history to a relative (`@cast letter`: the reader lives
# where the record lies, the writer is their kin, mostly away; `far` 1 when they are), in the present, the news in the past. The
# news is the letter's register (letter_events*.vg, `@news`); the rest is the ordinary life the records are mostly made of
# (letters_life.vg, letters_life2.vg: the children, the work, the house, the table, the market, the sky, the faith, the sayings), told in
# the people's own things (their crop, their herd, their vessels, their houses, their feasts) so no two peoples' letters read alike.
# Each people keeps its own few greetings and farewells (`people=K`): one people opens "Mother, the {crop} is in", another "From the
# house under the hill, greeting". `$me` is I, `$you` is you; `$kin`, `$child`, `$spouse` the writer's own, when the history has them.

# ---- the letter -------------------------------------------------------------------------------------------------------------

genre.letter (words=27..210)
  (5) {@cast letter}{letter.open}\n{letter.body}\n{letter.close}
  (1) {@cast letter}{letter.open}\n{letter.body}\n{letter.close}\n{let.ps}

letter.body
  (3) {@news private letter}\n{@news public letter}\n{letter.ambient} {letter.ambient}\n{letter.end}
  (2) {@news private letter} {letter.ambient}\n{@news public letter}\n{letter.end}
  (2) {@news public letter}\n{@news private letter}\n{letter.ambient}\n{letter.end}
  (2) {letter.ambient} {letter.ambient}\n{@news private letter}\n{@news public letter}\n{letter.end}
  (2) {@news private letter}\n{letter.ambient} {letter.ambient} {letter.ambient}\n{letter.end}
  (1) {letter.ambient}\n{@news private letter}\n{@news private letter}\n{letter.ambient}\n{letter.end}
  (2) {letter.ambient}\n{@news public letter} {letter.ambient}\n{letter.end}
  (1) {@news near letter}\n{letter.ambient} {letter.ambient}\n{letter.end}
  (1) {letter.ambient} {letter.ambient}\n{@news public letter}\n{letter.ambient}\n{letter.end}
  (1) {letter.ambient}\n{@digest any letter 3}\n{letter.end}
  (2 stage>=1) {@news public letter}\n{@news private letter}\n{@news public letter}\n{letter.end}
  (1 stage>=2) {@news public letter}\n{letter.ambient}\n{@news public letter}\n{letter.end}

# the greeting: each people its own few, by the age
letter.open (formula people=6)
  (age<=medieval far=1) To {$you:full} at {$you.home}, from {$me:name} at {$me.home}.
  (age<=medieval far=1) To {$you:full} at {$you.home}, from {$me:name} at {$me.home}, greeting.
  (age<=medieval far=1) {$you:voc}, this goes with {letter.carrier}, so it will be [a month|half a season|a long while] on the road, and the news older than it looks.
  (age<=medieval far=1) {$you:voc}, I give this to {letter.carrier}; if it reaches you, {god.keep}.
  (age<=medieval) {$you:voc}, the [priest|scribe at the hall|trader's boy|schoolmaster] is writing this for me, so I will be short, and [he will know everything|everyone will know everything by evening].
  (age<=medieval stage<2) {$you:voc}, greetings, and the {crop} [is in|is not in yet|is late again], which you will want to know first.
  (age<=medieval far=0) {$you:voc}, I am writing because you will not come to the door, and I will not go to yours.
  (age<=medieval) {$you:voc}, {blessing}.
  (age<=medieval) From {$me.home}, where the {herd} are fat and the news is thin, to {$you:voc}.
  (age<=medieval) {$you:voc}, it is late and the house is asleep, so I take up the pen.
  (age<=medieval) {$you:voc}, health to you and to the house, and to the {herd} if you still keep them.
  (age<=medieval) {$you:voc}, {exclaim}, it has been too long.
  (age<=medieval) Greeting to {$you:voc} from {$me:name}, who has not forgotten you whatever you have heard.
  (age=industrial) Dear {$you:voc},
  (age=industrial) My dear {$you:voc},
  (age=industrial) Dearest {$you:voc},
  (age=industrial far=1) {$you:voc}, a line by the [evening|morning|night] post.
  (age=industrial far=1 inv.railway=1) {$you:voc}, they say a letter is two days on the railway now, so this will find you before the season is out.
  (age=industrial far=0) {$you:voc}, since we live at opposite ends of the same town and never see each other:
  (age=industrial) {$you:voc}, your letter came on [the fourth|the ninth|a wet day|the day the {herd} got out] and I have read it twice.
  (age=industrial) {$you:voc}, I am writing this at the kitchen table with {food} going cold beside me.
  (age=industrial) {$you:voc}, forgive the paper; it was all the shop had.
  (age=industrial) {$you:voc}, a quick one, the lamp is low.
  (age>=modern) {$you:voc},
  (age>=modern) {$you:voc}, it's me.
  (age>=modern far=1) {$you:voc}, the line to {$you.home} is down again, so I'm writing instead.
  (age>=modern) {$you:voc}, I know, a letter. Humour me.
  (has:$you.kin $you.kin=son|$you.kin=daughter) {$you:voc}, {endear},

# who carries it
letter.carrier
  a trader going to {$you.home} with {trade}
  a boatman going down {river}
  the carter, under the {crop}
  the priest's boy, who has legs to spare
  pilgrims going your way for {festival}
  a man who sells {vessel} along the road
  the {craft} people going to the fair
  a cousin of the miller's, who owes me a favour
  the drovers, with the {herd}
  (coast=1) a fishing boat going round the point

# the farewell: each people its own few
letter.close (formula people=6)
  (age<=medieval) {god.keep}. {$me:name}.
  (age<=medieval has:$me.yourkin) {god.keep} and the house. Your {$me.yourkin}, {$me:name}.
  (age<=medieval) Under {skyone}, at {$me.home}. {$me:name}.
  (age<=medieval) {blessing}. {$me:name}.
  (age<=medieval has:$me.yourkin) Your {$me.yourkin}, who thinks of you {time.of}, {$me:name}.
  (age<=medieval) Written at {$me.home} in {season.now}, by {$me:name}.
  (age<=medieval) Keep well. Keep warm. Keep the {herd} out of the {crop2}. {$me:name}.
  (age<=medieval) Swear to me {oath} that you will answer. {$me:name}.
  (age<=medieval) From your own {$me:name}, at the sign of {motif.over} over the door.
  (age=industrial has:$me.yourkin) Your {$me.yourkin}, {$me:name}
  (age=industrial) With love to all of you, {$me:name}
  (age=industrial) Yours ever, {$me:name}
  (age=industrial) In haste for the post, {$me:name}
  (age=industrial) Yours, and the house's, {$me:name}
  (age=industrial) Kisses to the little ones. {$me:name}
  (age=industrial) {blessing}. {$me:name}
  (age>=modern) Write back. {$me:name}
  (age>=modern) Love, {$me:name}
  (age>=modern has:$me.yourkin) Your {$me.yourkin}
  (age>=modern) Take care of yourself. {$me:name}
  (stage>=2) Come if you can. If you cannot, {god.keep}. {$me:name}

# after the name, a thing forgotten
let.ps
  One more thing: {let.ps.what}
let.ps.what (share=0.8)
  the {vessel.one.n} you left is still here, and I am not keeping it for you.
  I forgot to say that {proverb}; Mother used to say it, and I keep thinking of it.
  tell nobody what I said about the {herd}, or about the {craft} people.
  I said I would not mention the money, so I have not, except for the {smallcoin} you know about.
  the {beast} sends its regards, or would if it could spell.
  bring {food} if you come; ours is not what it was since the {crop} went thin.
  the {bird} are back on the roof, and you will know what that means.
  I have kept the last of the {drink} for you, so do not be too long about coming.
  (age>=industrial) the stamp cost more than the paper and the {food} put together; reply anyway.
  burn the {crop} straw for me at {festival}, as we used to, by {town.edge}.
  the {colour.holy} thread is for the child, for luck, and not for the {beast} to eat.
  if you see the {craft} woman, tell her the {vessel.one.n} cracked, and I want my {smallcoin} back.

letter.end
  (2) {letter.ask}
  (2) {letter.feel}
  {letter.feel} {letter.ask}
  {letter.question} {letter.ask}
  {let.saying.end}
  (has:$you) {letter.question} {letter.feel}

letter.ask
  {ask.what} {ask.tail}
ask.what (share=0.75)
  send [linen thread|a measure of {trade}|seed for the upper field|{vessel.one} of {food}|news of the {herd}] {=.send}
  send word of {$you.home} {=.send}
  come for {festival} {=.come}
  come for {feast.custom} {=.come}
  (far=1) write back by the same hand {=.write}
  (far=1 age=industrial) write when you can, even a line {=.write}
  (stage>=2 far=1) if it is better where you are, tell me plainly, and we will come {=.plain}
  (stage>=2) do not come back for the house; the house will keep {=.plain}
  (age=industrial inv.telegraph=1) if anything is wrong, wire; do not wait for the post {=.plain}
  (age=industrial inv.railway=1 far=1) take the train for {festival}; I will meet every one {=.come}
  (age>=modern) call when you get this {=.write}
  burn this when you have read it {=.burn}
  remember me to everyone at {holyplace}, and to nobody at {hall} {=.plain}
  tell me everything, and slowly {=.write}
  bring the {let.instrument} when you come {=.come}
  keep the {garment.n} I sent; it was my mother's {=.plain}
  ask the {craft} people at {$you.home} if they will take an apprentice {=.send}
  eat something besides {food} {=.plain}
  (has:$you.kin $you.kin=brother|$you.kin=sister) write back, {fool.word} {=.write}
  light a lamp for me at {holyplace}, and a {colour.holy} one for Mother {=.plain}
ask.tail
  (3) .
  (.send=1) , if [the traders bring any|you can spare it|it is to be had].
  (.come=1) , [if the road allows|if the river is down|when the {crop} is in|before {season.next}]. [The children ask.|There is a bed.|It has been too long.|The {herd} will not miss you for a week.]
  (.write=1) ; I have nothing but time until {season.next}.
  (.burn=1) ; you know how they talk at {$you.home}.
  (.burn=1) ; the walls at {$you.home} have ears, and the ears have cousins.
  (.burn=1) , or feed it to the {beast}, which talks less than the neighbours.
  (.burn=1) ; put it in the {fuel} and say nothing.

letter.question (share=0.8)
  How is the {crop} at {$you.home}? Ours is [late|early|a disgrace|better than it deserves].
  Is the road over {mountain} open yet, or are the carters still going round by {river} with the {trade}?
  Do you still keep the {herd}, or have you given them up as you said you would?
  Does {skyone} rise over your {roofs} the way it does over ours?
  Are you eating anything but {food}? You never ate.
  Is it true what they say about the {watersrc.n} at {$you.home}, that the {herd} will not drink from it?
  (has:$you.home.landmark) Who has the house by {$you.home.landmark} now, with the {colour.holy} door?
  (age>=industrial) Did the parcel come, or has the post eaten it?
  Have you found anyone who makes {food} the way we do?
  Do they keep {festival} properly at {$you.home}, with {feast.custom}, or is it all speeches?
  Are the {bird} back at {$you.home} yet? Ours came early.
  Do you still go in for {pastime}, or have you grown too grand?
  What do they burn at {$you.home}, still {fuel}?
  Has anyone there learnt to {let.skill} yet, or is it still only you?

letter.feel
  {feel.main} {feel.tail}
feel.main (share=0.7)
  (!has:.thought has:$you) I think of you [{time.of}|when the lamps are lit|every {festival}|more than I write]
  (temper=proud) we are doing well, I swear it {oath}
  (stage<0) it is a good year for the {crop} here, as these things go
  (stage>=1) it is not like it was {=.lament}
  (stage>=2) I do not know what to tell you that you do not know
  (age=industrial) the town is louder every year and I am quieter, so it evens out
  (temper=wry) I am well, which surprises everyone
  (temper=anxious) I worry about you on that road {=.worry}
  (temper=pious) I keep a lamp for you at {holyplace}
  (temper=plain) the house is the same, the {herd} are the same, and I am a little older
  (temper=proud) we have done well this year, and I will say so
  some days I miss you more than I can say, and some days I am too busy to
  that is all the news {=.done}
  (has:$you) the house has a hole in it the shape of you, and the {beast} sits in it
  life is {life.is}, as you used to say, and you were right, which I will not say twice
  (temper=wry) I am as well as {vice} allows
  (temper=pious) I pray for {virtue}, and get {weather.now}
feel.tail
  .
  (.lament=1) ; I suppose it never is.
  (.worry=1) ; I worry about everyone on every road.
  (!has:.done !has:.worry !has:.lament) , and that is the truth, as {skyone} sees me.
  (!has:.done !has:.worry !has:.lament) ; I swear it {oath}.
  (!has:.done) , as the {bird} would say if they could.
  (!has:.done) ; tell that to the {herd}.
  (!has:.done) , and the {fuel} is lit, and that will do.

# a saying at the end, and whose it is
let.saying.end
  {let.saying.lead} {proverb}{let.saying.tail}
let.saying.lead
  Remember what Mother said:
  As the old ones say,
  You know the saying:
  (temper=wry) As my neighbour never stops telling me,
  (temper=pious) It is written over {holyplace}:
  They say here,
let.saying.tail (share=0.8)
  ; I did not believe it either.
  ; I believe it more every year.
  , and it is truer than it sounds.
  ; write back and tell me I am wrong.
  (temper=wry) ; it sounds better than it works.
  , and the {herd} seem to know it too.
  ; I thought of it at the {craft} today.
  , and I think of it whenever I see {vessel}.
  (2) .

# small words the letters share
let.instrument (people=2)
  drum
  flute
  pipes
  horn
  lyre
  harp
  (age>=medieval) fiddle
  (age>=medieval) lute
let.skill (people=6)
  mend a net
  set a bone
  make the {crop} beer
  dye with {crop2}
  read the old marks
  sing the long songs
  keep bees
  tell the weather from {skyone}
  shoe a {beast}
  make {food} the way Mother did
  (age>=medieval) read the lintel
  (age>=medieval) cut a stela
  (age>=medieval) keep accounts
  (age>=industrial) read the timetables
  (age>=industrial) mend the pump
  (age>=industrial) work a sewing machine
)VG"
