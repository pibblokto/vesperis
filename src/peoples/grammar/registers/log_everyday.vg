R"VG(
# log_everyday.vg (H-04, the second pass): the log's register for the everyday (a fire, a storm, a law, a trial, an accident, a price, games, a
# show, a visit, envoys, a fair, a pest, a wonder: the quiet years' entries), and each people's way of keeping a log: how an entry is
# closed, how the sick are kept apart, how a quiet watch is written (`people=K`).

# ---- the everyday --------------------------------------------------------------------------------------------------------------

log.fire
  {mod.lg.tag} Fire at {$e.place}: {mod.lg.firewhat}. Houses lost: {#$e.value:digits}. {mod.lg.ack}
  {mod.lg.tag} Fire reported in {$e.place}, {mod.lg.firewhat}. Out by {mod.lg.hour}. {mod.lg.ack}
  {mod.lg.tag} Alarm from {$e.place}: {mod.lg.firewhat} alight; {#$e.value:digits} houses burned. Cause under inquiry.
  {mod.lg.tag} {$e.place}: the fire in {mod.lg.firewhat} still burning at {mod.lg.hour}. Crews relieved. {mod.lg.ack}
mod.lg.firewhat
  ($e.what=street) a street of houses
  ($e.what=half) half the town
  ($e.what=granary) the granary
  ($e.what=market) the market
  ($e.what=temple) the temple
  ($e.what=mill) the mill
  ($e.what=library) the library
  ($e.what=harbour) the harbour sheds
  ($e.what=palace) the palace
  ($e.what=works) the works
  ($e.what=camp) the camp
  ($e.what=grass) the grassland
  ($e.what=forest) the woods
  ($e.what=tower) a tower block

log.storm
  (has:$e.place) {mod.lg.tag} Storm at {$e.place}: {mod.lg.stormwhat}. {mod.lg.toll}
  (!has:$e.place) {mod.lg.tag} {mod.lg.stormwhat} across the district. {mod.lg.toll}
  {mod.lg.tag} Storm warning in force. {mod.lg.stormwhat} through the night. {mod.lg.ack}
  (has:$e.place) {mod.lg.tag} Weather: {mod.lg.stormwhat} at {$e.place}, worse than forecast. {mod.lg.toll}
mod.lg.stormwhat
  ($e.what=wind) gale-force winds
  ($e.what=hail) hail the size of eggs
  ($e.what=snow) heavy snow
  ($e.what=dust) a dust storm
  ($e.what=sea) a storm surge on the front
  ($e.what=lightning) lightning on the mast
  ($e.what=rain) flooding rain
mod.lg.toll
  ($e.value>0) {#$e.value:digits} dead.
  ($e.value=0) No casualties. Roofs and lines down.

log.pest
  (has:$e.place) {mod.lg.tag} {mod.lg.pestwhat} reported at {$e.place}. Inspectors sent. {mod.lg.ack}
  (has:$e.place) {mod.lg.tag} {$e.place}: {mod.lg.pestwhat}. Spraying ordered. {mod.lg.ack}
  (!has:$e.place) {mod.lg.tag} {mod.lg.pestwhat} in the district. Movement of {herd} stopped.
mod.lg.pestwhat
  ($e.what=locusts) locust swarms
  ($e.what=blight) blight on the {crop}
  ($e.what=murrain) sickness in the {herd}
  ($e.what=rats) rats in the stores
  ($e.what=worm) worm in the fields
  ($e.what=mildew) mildew in the stores
  ($e.what=wolves) wild dogs at the herds
  ($e.what=mites) mites in the filters

log.wonder
  (has:$e.place) {mod.lg.tag} {$e.place}: {mod.lg.wonderwhat}. Passed to the museum. {mod.lg.ack}
  (has:$e.place) {mod.lg.tag} Unusual report from {$e.place}: {mod.lg.wonderwhat}. Not verified.
  (!has:$e.place) {mod.lg.tag} Reported: {mod.lg.wonderwhat}. Not verified. {mod.lg.ack}
mod.lg.wonderwhat
  ($e.what=calf) a calf born with two heads
  ($e.what=fish) a fish of record size landed
  ($e.what=hoard) a hoard of old coins dug up
  ($e.what=stone) a stone fell from a clear sky
  ($e.what=rain) red rain
  ($e.what=spring) the spring ran warm
  ($e.what=beast) a white beast seen at the edge of the town
  ($e.what=bones) great bones found in the quarry
  ($e.what=twins) triplets born, all well
  ($e.what=tree) a tree in flower out of season
  ($e.what=bell) the bell rang with nobody at the rope
  ($e.what=ruin) the walls of an older town found under the road
  ($e.what=signal) a signal received that matches nothing known

log.games
  {mod.lg.tag} Games at {$e.place}: {mod.lg.gameswhat}. {mod.lg.winner} Half shifts for the day.
  {mod.lg.tag} {mod.lg.gameswhat} at {$e.place}. {mod.lg.winner} {mod.lg.ack}
  (has:$e.a) {mod.lg.tag} {$e.place}: {mod.lg.gameswhat}, won by {$e.a:full}. The staff had a holiday.
mod.lg.gameswhat
  ($e.what=race) the long race
  ($e.what=wrestling) the wrestling
  ($e.what=archery) the archery
  ($e.what=boats) the boat races
  ($e.what=ball) the ball games
  ($e.what=song) the singing contest
  ($e.what=horses) the horse races
  ($e.what=chess) the board-game championship
  ($e.what=swimming) the swimming
mod.lg.winner
  (has:$e.a) Won by {$e.a:full}.
  (!has:$e.a) Result not recorded.

log.law
  {mod.lg.tag} New order in force: {mod.lg.lawwhat}. {mod.lg.ack}
  (has:$e.a) {mod.lg.tag} Decree of {$e.a:full}: {mod.lg.lawwhat}. Notices posted.
  {mod.lg.tag} Circular from {$seat}: {mod.lg.lawwhat}, from the first of the month.
  {mod.lg.tag} Instruction received: {mod.lg.lawwhat}. Staff informed. {mod.lg.ack}
mod.lg.lawwhat
  ($e.what=measures) new weights and measures
  ($e.what=tax) a new tax on {fuel}
  ($e.what=water) water rationed by district
  ($e.what=tolls) tolls on the bridge road
  ($e.what=curfew) a curfew at the tenth hour
  ($e.what=coin) the new coinage
  ($e.what=inheritance) the law of inheritance revised
  ($e.what=drink) the sale of {drink} restricted
  ($e.what=weapons) no weapons to be carried in the streets
  ($e.what=school) schooling for every child
  ($e.what=census) a census of every household
  ($e.what=calendar) the calendar reformed
  ($e.what=dogs) dogs to be licensed
  ($e.what=hours) working hours limited
  ($e.what=noise) no noise after the eleventh hour
  ($e.what=forests) no cutting in the forests
  ($e.what=rations) rations by card

log.trial
  (has:$e.a) {mod.lg.tag} Trial of {$e.a:full} for {mod.lg.charge}: {mod.lg.verdict}. {mod.lg.ack}
  (!has:$e.a has:$e.place) {mod.lg.tag} Trial at {$e.place} for {mod.lg.charge}: {mod.lg.verdict}.
  (has:$e.a has:$e.place) {mod.lg.tag} Court at {$e.place}: {$e.a:full}, {mod.lg.charge}, {mod.lg.verdict}.
mod.lg.charge
  ($e.what=theft) theft
  ($e.what=murder) murder
  ($e.what=treason) treason
  ($e.what=heresy) heresy
  ($e.what=forgery) forgery
  ($e.what=fraud) fraud
  ($e.what=smuggling) smuggling
  ($e.what=bribery) bribery
  ($e.what=arson) arson
  ($e.what=libel) libel
mod.lg.verdict
  ($e.verdict=acquitted) acquitted
  ($e.verdict=condemned) convicted
  ($e.verdict=exiled) sentenced to exile
  ($e.verdict=fined) fined

log.embassy
  ($e.what=city has:$e.place2 has:$e.place) {mod.lg.tag} Delegation from {$e.place2} received at {$e.place}. {mod.lg.ack}
  ($e.what=others has:$e.place) {mod.lg.tag} Delegation of the {other} received at {$e.place}. Protocols applied.
  ($e.what=sent) {mod.lg.tag} Our delegation left for the {other} today. {mod.lg.ack}
  (has:$e.place) {mod.lg.tag} Visitors of state at {$e.place}. Security doubled. {mod.lg.ack}
  {mod.lg.tag} Delegation received. Protocols applied.

log.accident
  (has:$e.place) {mod.lg.tag} {mod.lg.accwhat} at {$e.place}. {#$e.value:digits} dead. Inquiry ordered.
  (has:$e.place) {mod.lg.tag} {$e.place}: {mod.lg.accwhat}. Rescue crews sent. Dead: {#$e.value:digits}. {mod.lg.ack}
  (has:$e.place) {mod.lg.tag} Emergency at {$e.place}: {mod.lg.accwhat}, {#$e.value:digits} dead. {mod.lg.ack}
mod.lg.accwhat
  ($e.what=bridge) bridge collapse
  ($e.what=mine) mine collapse
  ($e.what=ship) ship lost
  ($e.what=train) train derailed
  ($e.what=explosion) explosion at the works
  ($e.what=dam) dam breach
  ($e.what=aircraft) aircraft down
  ($e.what=reactor) reactor fault
  ($e.what=habitat) habitat breach
  ($e.what=tower) tower collapse
  ($e.what=well) well collapse

log.price
  ($e.out=1) {mod.lg.tag} Price of {mod.lg.pricewhat} up {#$e.value:digits} in a hundred. Canteen prices revised.
  ($e.out=0) {mod.lg.tag} Price of {mod.lg.pricewhat} down {#$e.value:digits} in a hundred. {mod.lg.ack}
  ($e.out=1) {mod.lg.tag} Notice: {mod.lg.pricewhat} dearer from today, by {#$e.value:digits} in a hundred. {mod.lg.ack}
mod.lg.pricewhat
  ($e.what=bread) bread
  ($e.what=salt) salt
  ($e.what=oil) lamp oil
  ($e.what=rent) rent
  ($e.what=cloth) cloth
  ($e.what=meat) meat
  ($e.what=fuel) fuel
  ($e.what=water) water

log.show
  (has:$e.a has:$e.place) {mod.lg.tag} New {mod.lg.showwhat} by {$e.a:full} shown at {$e.place}. Staff given tickets.
  (has:$e.place) {mod.lg.tag} {$e.place}: first showing of a new {mod.lg.showwhat}. {mod.lg.ack}
  (has:$e.a) {mod.lg.tag} {$e.a:full}'s new {mod.lg.showwhat} opened. The night shift asked for leave. Refused.
mod.lg.showwhat
  ($e.what=play) play
  ($e.what=song) song cycle
  ($e.what=pictures) exhibition
  ($e.what=film) film
  ($e.what=dance) dance
  ($e.what=poem) poem
  ($e.what=statue) statue

log.visit
  (has:$e.a has:$e.place) {mod.lg.tag} Visit of {$e.a:full} to {$e.place}. Station cleaned and painted. {mod.lg.ack}
  (has:$e.a has:$e.place) {mod.lg.tag} {$e.a:full} at {$e.place} today. Roads closed for the procession.
  (has:$e.a has:$e.place) {mod.lg.tag} {$e.a:full} toured the works at {$e.place}. Asked two questions. {mod.lg.ack}

log.fair
  (has:$e.place) {mod.lg.tag} Fair at {$e.place}: {mod.lg.fairwhat}. {#$e.value:digits} visitors. Extra services.
  (has:$e.place) {mod.lg.tag} {$e.place}: the {mod.lg.fairwhat} fair. Traffic heavy. {mod.lg.ack}
mod.lg.fairwhat
  ($e.what=beasts) beasts
  ($e.what=cloth) cloth
  ($e.what=salt) salt
  ($e.what=grain) grain
  ($e.what=pots) pottery
  ($e.what=iron) ironware
  ($e.what=wine) wine
  ($e.what=fish) fish
  ($e.what=furs) furs
  ($e.what=gathering) the old gathering
  ($e.what=horses) horses
  ($e.what=books) books
  ($e.what=machines) machines
  ($e.what=flowers) flowers

# ---- a people's way of keeping its log --------------------------------------------------------------------------------------

mod.lg.tag (people=1)
  (2)
  Notice:
  Report:
  Event:
  Note:
  Entry:
  Signal:
  Item:
  Received:
  Watch:

mod.lg.ack (people=3)
  Logged.
  Noted.
  Report filed.
  Forwarded to {$seat}.
  Copy to the archive.
  No further action.
  Acknowledged.
  Entered in the book.
  Passed to the duty officer.
  Reported up.
mod.lg.sick (people=2)
  Isolation ordered.
  Quarantine of the district in force.
  Clinics open through the night.
  Masks issued to the crews.
  Water to be boiled.
  The sick kept apart.
mod.lg.where
  low streets
  market
  river quarter
  lower town
  road to {$seat}
mod.lg.hour
  dawn
  noon
  midnight
  first light
  the second watch
mod.lg.quiet (people=2)
  Quiet.
  Watch uneventful.
  Nothing in or out.
  All in order.
  Nothing moved.
)VG"
